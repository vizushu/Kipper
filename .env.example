# ── Casa Pacifica direct-booking site ─────────────────────────────
# Copy to .env and fill in. NEVER commit real secrets.

# Data layer: "sqlite" (dev, zero-config file DB) or "supabase" (prod)
DATA_ADAPTER=sqlite
SQLITE_PATH=./data/bookings.db

# Supabase (prod) — Renier must create the project and supply these
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Stripe — TEST MODE ONLY in development. Never use live keys in dev.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Apple Pay on the web also requires: Apple Developer Merchant ID +
# domain verification file at /.well-known/apple-developer-merchantid-domain-association
APPLE_PAY_MERCHANT_ID=

# Email — Resend in prod; dev logger writes to .dev-emails/ when unset
RESEND_API_KEY=
EMAIL_FROM="Casa Pacifica <stay@casapacifica.example>"
HOST_NOTIFICATION_EMAIL=

# Admin dashboard protection — set a long random secret
ADMIN_SECRET=
ADMIN_SESSION_COOKIE=cp_admin_session

# Public site URL (used in emails + Apple Pay domain checks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
