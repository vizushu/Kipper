# ── Casa Pacifica direct-booking site ─────────────────────────────
# Copy to .env and fill in. NEVER commit real secrets.

# Data layer: sqlite (single persistent-instance deployment) or optional supabase
DATA_ADAPTER=sqlite
SQLITE_PATH=./data/bookings.db

# Supabase (prod) — Renier must create the project and supply these
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Booking is disabled by default. Explicit test-only preview; no live payment path.
SITE_PREVIEW_MODE=false
BOOKING_TEST_MODE=false
# Set >=32 random bytes in secret manager. No sample signing key is shipped.
BOOKING_ACCESS_SECRET=

# Stripe — TEST MODE ONLY. Live keys are rejected in every environment.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Wallet availability needs Stripe merchant/account and domain verification;
# real device/browser validation is outstanding. Never display a fake wallet.

# Email — Resend in prod; dev logger writes to .dev-emails/ when unset
EMAIL_DELIVERY_MODE=disabled
RESEND_API_KEY=
BOOKING_FROM_EMAIL="Casa Pacifica <stay@casapacifica.example>"
HOST_NOTIFY_EMAIL=

# Admin dashboard protection — set a long random secret
ADMIN_SECRET=
ADMIN_SESSION_COOKIE=cp_admin_session

# Public site URL (used in emails + Apple Pay domain checks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Guest contact links: only dedicated public guest spaces/numbers explicitly approved for publication.
# No private team channels, personal phone numbers, API keys or dot thread URLs.
# Public preview strips every destination regardless of this flag.
GUEST_CONTACT_LINKS_APPROVED=false
GUEST_CONTACT_SLACK_URL=
GUEST_CONTACT_DISCORD_URL=
GUEST_CONTACT_SMS_NUMBER=
# Ask dot remains unavailable: no supported guest integration is configured.
